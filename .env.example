# ─── Copia este archivo a .env y rellena los valores ───
# En Railway estos se ponen en la pestaña Variables.

# Base de datos (Railway la crea sola al añadir Postgres)
DATABASE_URL=postgresql://...

# Stripe (panel de Stripe → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SETUP=price_...        # producto de 25€ (pago único)
STRIPE_PRICE_MONTHLY=price_...      # producto de 5€/mes
MAX_PAYMENT_RETRIES=3

# Telegram
MASTER_BOT_TOKEN=123456:ABC...      # token del bot maestro (creado con BotFather)
OWNER_TELEGRAM_ID=123456789         # tu id de Telegram (avisos de admin)

# Railway (Account Settings → Tokens)
RAILWAY_TOKEN=...
BOT_TEMPLATE_REPO=AdriDz/bot-template   # repo con la plantilla del bot

# App
PUBLIC_URL=https://tu-orquestador.up.railway.app
PORT=8000
